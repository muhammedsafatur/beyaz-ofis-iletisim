PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/beyaz_ofis
# En az 32 karakter. Erişim belirteçlerini imzalar.
JWT_SECRET=degistir-en-az-32-karakterlik-uzun-bir-deger
# ClamAV (üretimde zorunlu). docker-compose: localhost:3310
CLAMD_HOST=localhost
CLAMD_PORT=3310
# Expo Push bildirimleri için 1
EXPO_PUSH=0
